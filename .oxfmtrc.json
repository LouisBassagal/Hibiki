{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": true,
  "trailingComma": "es5",
  "experimentalSortImports": {
    "groups": [
      [
        "builtin"
      ],
      [
        "external"
      ],
      [
        "internal"
      ],
      [
        "parent",
        "sibling",
        "index"
      ]
    ],
    "internalPattern": [
      "@lib/",
      "~/"
    ]
  },
  "experimentalSortPackageJson": true,
  "ignorePatterns": [
    "dist/",
    "build/",
    "node_modules/",
    ".env"
  ]
}
